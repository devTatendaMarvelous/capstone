# SmartCrop environment template.
# Copy this file to .env and replace every placeholder.
# Never commit .env or real secrets.

# --- Backend ---
# Use at least 32 characters. PyJWT warns on shorter HMAC keys.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://smartcrop:change-me@localhost:5432/smartcrop
JWT_SIGNING_KEY=change-me-to-a-long-random-string
SMARTCROP_DEMO_PASSWORD=change-me-before-sharing
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional override for seed_demo. Defaults to data-science/data/processed/clean_dataset.csv.
# SMARTCROP_CLEAN_DATASET=

# --- Data science ---
SMARTCROP_RANDOM_SEED=42
